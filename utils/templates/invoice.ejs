<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<title>Invoice <%= invoice.invoiceNumber %></title>

<style>
  body {
    font-family: Arial, sans-serif;
    padding: 0;
    margin: 0;
    background: #f6f7f9;
  }

  .invoice-box {
    max-width: 800px;
    margin: auto;
    background: #fff;
    padding: 30px;
    border: 1px solid #eee;
    font-size: 14px;
    color: #555;
  }

  .header {
    text-align: center;
    margin-bottom: 25px;
  }

  .header h1 {
    margin: 0;
    font-size: 26px;
    color: #333;
  }

  .meta, .customer-info {
    margin-bottom: 25px;
    width: 100%;
  }

  .meta table, .customer-info table, .summary table {
    width: 100%;
    border-collapse: collapse;
  }

  .meta table td,
  .customer-info table td {
    padding: 5px 0;
  }

  .items table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 30px;
  }

  .items table th {
    background: #f1f1f1;
    padding: 10px;
    border-bottom: 1px solid #ddd;
    text-align: left;
    font-weight: bold;
  }

  .items table td {
    padding: 10px;
    border-bottom: 1px solid #eee;
  }

  .summary {
    width: 100%;
    margin-top: 20px;
  }

  .summary table td {
    padding: 8px 0;
  }

  .total-row {
    font-size: 18px;
    font-weight: bold;
    color: #000;
  }

  .comment-box {
    margin-top: 20px;
    padding: 15px;
    background: #fafafa;
    border-left: 4px solid #3498db;
  }

  .footer {
    margin-top: 40px;
    text-align: center;
    color: #777;
    font-size: 12px;
  }
</style>

</head>

<body>
<div class="invoice-box">

  <!-- Header -->
  <div class="header">
    <h1>INVOICE</h1>
    <p><%= invoice.invoiceNumber %></p>
  </div>

  <!-- Invoice Metadata -->
  <div class="meta">
    <table>
      <tr>
        <td><strong>Date:</strong></td>
        <td><%= new Date(invoice.dateTime * 1000).toLocaleString() %></td>
      </tr>
      <tr>
        <td><strong>Airport:</strong></td>
        <td><%= invoice.airport %></td>
      </tr>
      <tr>
        <td><strong>Status:</strong></td>
        <td style="text-transform: capitalize;"><%= invoice.status %></td>
      </tr>
      <tr>
        <td><strong>GST No:</strong></td>
        <td>03NTHPS8695L1ZG</td>
      </tr>
    </table>
  </div>

  <!-- Customer Info -->
  <div class="customer-info">
    <table>
      <tr>
        <td><strong>Billed To:</strong></td>
      </tr>
      <tr><td><%= invoice.customer?.name || "Walk-in Customer" %></td></tr>
    </table>
  </div>

  <!-- Items Table -->
  <div class="items">
    <table>
      <thead>
        <tr>
          <th>Item</th>
          <th>Qty</th>
          <th>Unit Price</th>
          <th>Total</th>
        </tr>
      </thead>

      <tbody>
        <% invoice.items.forEach(item => { %>
          <tr>
            <td><%= item.name %></td>
            <td><%= item.quantity %></td>
            <td>₹<%= item.perUnitPrice.toFixed(2) %></td>
            <td>₹<%= item.totalPrice.toFixed(2) %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <!-- Summary -->
  <div class="summary">
    <table>
      <tr>
        <td><strong>Subtotal:</strong></td>
        <td>₹<%= invoice.subTotal.toFixed(2) %></td>
      </tr>
      <tr>
        <td><strong>Tax (<%= invoice.taxPercentage %>%):</strong></td>
        <td>₹<%= ((invoice.subTotal * invoice.taxPercentage) / 100).toFixed(2) %></td>
      </tr>
      <tr class="total-row">
        <td>Total:</td>
        <td>₹<%= invoice.totalAmount.toFixed(2) %></td>
      </tr>
    </table>
  </div>

  <!-- Comment -->
  <% if (invoice.comment) { %>
    <div class="comment-box">
      <strong>Comment:</strong><br />
      <%= invoice.comment %>
    </div>
  <% } %>

  <!-- Footer -->
  <div class="footer">
    This is a system-generated invoice — no signature required.
  </div>

</div>
</body>
</html>
